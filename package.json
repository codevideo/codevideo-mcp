{
  "name": "@fullstackcraftllc/codevideo-mcp",
  "version": "1.0.4",
  "description": "The MCP server for CodeVideo. Create software educational content using natural language.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "bin": {
    "codevideo-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && node scripts/build.mjs",
    "build-typescript": "tsc",
    "test": "node --import tsx --test test/*.test.ts",
    "type-check": "tsc --noEmit",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "verify-package": "node scripts/verify-package.mjs",
    "smoke:packed": "node scripts/smoke-packed.mjs",
    "release:check": "npm run type-check && npm test && npm run build && npm run verify-package && npm run smoke:packed && npm audit",
    "download-binaries": "tsx scripts/download-binaries.ts",
    "rest-server": "tsx src/rest-server/server.ts",
    "rest-server:dev": "tsx --watch src/rest-server/server.ts",
    "client:example": "tsx examples/rest-client.ts",
    "client:agent-example": "tsx examples/agent-client.ts",
    "examples:curl": "./examples/curl-examples.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codevideo/codevideo-mcp.git"
  },
  "keywords": [
    "CodeVideo",
    "mcp",
    "video",
    "productivity"
  ],
  "author": "Chris Frewin",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/codevideo/codevideo-mcp/issues"
  },
  "homepage": "https://github.com/codevideo/codevideo-mcp#readme",
  "dependencies": {
    "@fullstackcraftllc/codevideo-adapters": "^1.0.12",
    "@fullstackcraftllc/codevideo-cli": "^0.0.7",
    "@fullstackcraftllc/codevideo-dynamic-ast": "^1.0.5",
    "@fullstackcraftllc/codevideo-exporters": "^0.0.15",
    "@fullstackcraftllc/codevideo-types": "^2.2.0",
    "@fullstackcraftllc/codevideo-virtual-ide": "^1.0.43",
    "@google/genai": "^2.10.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.22.2",
    "node-fetch": "^3.3.2",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1",
    "ws": "^8.21.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^22.20.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.28.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
